# PIPI 백엔드 환경 설정
HOST=0.0.0.0
PORT=3000
DB_PATH=pipi.db

# 발표 당일 참석자용 공통 시연 계정 설정 (미설정 시 기본 계정 생성)
# DEMO_USER_ID=demo@pipi.app
# DEMO_USER_PASSWORD=pipi1234!
# (또는 DEMO_EMAIL, DEMO_PASSWORD 로도 설정 가능)

# 카카오 웹 OAuth 2.0 백엔드 토큰 교환 설정 (Render 환경 변수에 실제 키 등록 필요)
# KAKAO_REST_API_KEY=your_kakao_rest_api_key
# KAKAO_CLIENT_SECRET=

# 선택 사항: Flutter 웹 정적 빌드 파일 경로 (없을 경우 순수 REST API 서버로만 동작)
# WEB_BUILD_DIR=../PIPI-APEX--main/build/web
